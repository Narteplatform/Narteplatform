{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/promemoria",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/cancellazioni",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/misure-programmate",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/inviti",
      "schedule": "0 5 * * *"
    }
  ]
}
