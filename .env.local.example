# Supabase — progetto N'arte (project ref: nppzchkgzltcokvxcpji)
NEXT_PUBLIC_SUPABASE_URL=https://nppzchkgzltcokvxcpji.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Connessione Postgres diretta (per psql / Drizzle / migration runners locali)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.nppzchkgzltcokvxcpji.supabase.co:5432/postgres

# Resend (https://resend.com)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=N'arte <noreply@narte.it>

# --- Brevo (https://brevo.com) ---
# Provider email di destinazione. Resend resta attivo come rete di sicurezza:
# lib/emails/dispatch.ts usa Brevo solo per le chiavi elencate in
# BREVO_ENABLED_KEYS e, se Brevo fallisce o salta, ricade su Resend.
BREVO_API_KEY=xkeysib-xxx
BREVO_SENDER_EMAIL=narte@brevosend.com
BREVO_SENDER_NAME=N'arte

# Host pubblico da cui le email caricano logo e immagini. Le email non
# possono usare percorsi relativi: serve un URL assoluto e raggiungibile.
BREVO_ASSET_BASE_URL=https://narteplatform.vercel.app

# Chiavi instradate su Brevo, separate da virgola. Vuota = tutto continua a
# passare da Resend, com'era prima. `*` = tutte. È l'interruttore del
# cutover: per tornare indietro basta svuotarla e rifare il deploy.
# Esempio di rollout prudente (arrivano solo a noi):
#   BREVO_ENABLED_KEYS=contact_message,application_received_admin
BREVO_ENABLED_KEYS=

# Id dei template su Brevo. Li scrive `npm run email:sync -- --write-env`
# dopo averli pubblicati. Finché una chiave non ha il suo id,
# lib/brevo/registry.ts risolve null e l'invio ricade su Resend.
BREVO_TEMPLATE_APPLICATION_RECEIVED=
BREVO_TEMPLATE_APPLICATION_RECEIVED_ADMIN=
BREVO_TEMPLATE_ARTIST_APPROVED=
BREVO_TEMPLATE_ORGANIZER_REGISTRATION_RECEIVED=
BREVO_TEMPLATE_ORGANIZER_APPROVED=
BREVO_TEMPLATE_BOOKING_REQUEST_ARTIST=
BREVO_TEMPLATE_BOOKING_REQUEST_ADMIN=
BREVO_TEMPLATE_BOOKING_REQUEST_RECEIPT=
BREVO_TEMPLATE_LEAD_ARTIST=
BREVO_TEMPLATE_LEAD_ADMIN=
BREVO_TEMPLATE_BOOKING_ACCEPTED=
BREVO_TEMPLATE_BOOKING_CONFIRMED=
BREVO_TEMPLATE_BOOKING_DECLINED=
BREVO_TEMPLATE_BOOKING_CANCELLED_ADMIN=
BREVO_TEMPLATE_CHAT_NEW_MESSAGE=
BREVO_TEMPLATE_CONSULTATION_REQUEST_USER=
BREVO_TEMPLATE_CONSULTATION_REQUEST_ADMIN=
BREVO_TEMPLATE_CONSULTATION_CONFIRMED_ARTIST=
BREVO_TEMPLATE_CONSULTATION_CONFIRMED_ADMIN=
BREVO_TEMPLATE_CONTACT_MESSAGE=

# Email del superadmin (verra' promosso automaticamente al primo login)
SUPERADMIN_EMAIL=boostcreativeai@gmail.com

# Email su cui ricevere copia di tutti i lead
ADMIN_NOTIFICATION_EMAIL=boostcreativeai@gmail.com

# Public site URL (per link nelle email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password iniziali per gli account creati da `npm run db:seed-accounts`.
# Cambia subito dopo il primo accesso.
SEED_SUPERADMIN_PASSWORD=
SEED_ARTIST_PASSWORD=

# --- Stripe (abbonamenti artisti) ---
# Chiave segreta. In sviluppo usare quella di TEST (sk_test_...).
STRIPE_SECRET_KEY=
# Firma del webhook. In locale la stampa `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# In produzione: Stripe Dashboard → Developers → Webhooks → endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=
# Price id dei 4 piani. NON usare il prefisso NEXT_PUBLIC_: se il browser li
# conoscesse, potrebbe passare al checkout un price arbitrario (es. uno di test
# da 0,50 €) e ottenere Max. Il client manda {tier, interval}, il server risolve.
# Gli importi devono coincidere con PLAN_PRICES_CENTS in lib/billing/plans.ts.
STRIPE_PRICE_PRO_MONTH=      # 9,99 €/mese
STRIPE_PRICE_PRO_YEAR=       # 49,99 €/anno
STRIPE_PRICE_MAX_MONTH=      # 49,99 €/mese
STRIPE_PRICE_MAX_YEAR=       # 499,99 €/anno

# --- Statistiche del profilo (piano Max) ---
# Segreto usato per pseudonimizzare i visitatori del profilo pubblico:
# sha256(SALT | data Roma | IP | slug). L'IP non viene mai salvato.
# Almeno 32 byte casuali:  openssl rand -hex 32
# SENZA QUESTA CHIAVE IL TRACKING RESTA SPENTO, di proposito: con un salt
# debole o assente l'hash sarebbe ricostruibile da chiunque conosca un IP.
# Cambiarla azzera solo la deduplica del giorno in corso, non lo storico.
VISIT_HASH_SALT=
